# OPSIONAL — chatbot di /fitur/chatbot tetap berjalan penuh tanpa file ini
# (retrieval asli + jawaban dari template lokal, tanpa API key).
#
# Isi variabel ini kalau Anda mau jawaban benar-benar dihasilkan Claude:
# 1. Salin file ini ke .env.local (sudah di-gitignore)
# 2. Ambil API key di https://console.anthropic.com/settings/keys
# 3. Restart `npm run dev`
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
